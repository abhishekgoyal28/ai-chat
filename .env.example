# ---------------------------------------------------------------------------
# ai-chat configuration. Copy to .env and fill in every value marked REQUIRED.
# Generate secrets with:  openssl rand -base64 48   (AUTH_SECRET)
#                         openssl rand -base64 32   (ENCRYPTION_KEY — exactly 32 bytes)
# ---------------------------------------------------------------------------

# --- secrets (REQUIRED) -----------------------------------------------------
# Signs session tokens and dashboard sign-ins. At least 32 characters.
AUTH_SECRET=
# Encrypts LLM API keys and other secrets stored in the database.
# Changing it makes stored credentials unreadable — back it up.
ENCRYPTION_KEY=

# --- first dashboard admin (REQUIRED on first start) ------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- public addresses -------------------------------------------------------
# The URL users and your backend reach chat-app on (APIs and /admin dashboard).
PUBLIC_APP_URL=http://localhost:8080
# Where clients open the WebSocket. Leave empty when /socket.io is served on
# PUBLIC_APP_URL (the default compose and Helm setups do this).
PUBLIC_SOCKET_URL=
# Comma-separated browser origins allowed to call the client API and socket.
# Empty allows any origin (the APIs use bearer tokens, not cookies).
CORS_ORIGINS=

# --- docker compose only ----------------------------------------------------
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# A domain name here makes Caddy fetch a TLS certificate automatically,
# e.g. chat.example.com (point DNS at this machine, open ports 80/443 and set
# HTTP_PORT=80 HTTPS_PORT=443). ":80" serves plain HTTP.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- connections (set by compose; set them yourself elsewhere) --------------
# DATABASE_URL=mysql://user:password@host:3306/aichat
# REDIS_URL=redis://host:6379/0

# --- queue -----------------------------------------------------------------
# redis (default, uses REDIS_URL) or sqs.
QUEUE_DRIVER=redis
# For sqs: queues are <prefix><name> and <prefix><name>.fifo — see README.
# SQS_QUEUE_URL_PREFIX=https://sqs.us-east-1.amazonaws.com/123456789012/ai-chat-
# AWS_REGION=us-east-1

# --- tuning (defaults shown) ------------------------------------------------
# LOG_LEVEL=info
# SESSION_TOKEN_TTL_SEC=3600
# GENERATION_TIMEOUT_MS=90000
# LLM_TIMEOUT_MS=30000
# EXPERT_CONCURRENCY=10
# CONFIG_CACHE_TTL_MS=15000
# SOCKET_MAX_TURNS_PER_MINUTE=20
# HOST_API_RATE_LIMIT_PER_MINUTE=1200
# CLIENT_API_RATE_LIMIT_PER_MINUTE=120
