{
  "name": "@ai-chat/server",
  "version": "0.1.0",
  "private": true,
  "description": "The three ai-chat services: chat-app (REST, consumers, dashboard), chat-socket (WebSocket gateway) and chat-expert (LLM worker).",
  "license": "Apache-2.0",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand --forceExit",
    "migrate": "node dist/shared/database/migrate.js",
    "migrate:dev": "ts-node src/shared/database/migrate.ts",
    "start:app": "node dist/chat-app/main.js",
    "start:socket": "node dist/chat-socket/main.js",
    "start:expert": "node dist/chat-expert/main.js",
    "dev:app": "ts-node-dev --respawn --transpile-only src/chat-app/main.ts",
    "dev:socket": "ts-node-dev --respawn --transpile-only src/chat-socket/main.ts",
    "dev:expert": "ts-node-dev --respawn --transpile-only src/chat-expert/main.ts",
    "smoke": "node dist/tools/smoke-test.js",
    "smoke:dev": "ts-node --transpile-only src/tools/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@google/genai": "^1.52.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.0",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqs-consumer": "^11.6.0",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
